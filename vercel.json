{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/cricinfo-img/(.*)",
      "dest": "https://img1.hscicdn.com/$1",
      "headers": {
        "Referer": "https://www.espncricinfo.com/",
        "Origin": "https://www.espncricinfo.com"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
